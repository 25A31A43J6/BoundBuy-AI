# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
CLIENT_ORIGIN="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# MongoDB connection (Optional: if empty, resilient local persistent storage mode is active)
MONGODB_URI=""
MONGODB_DB_NAME="boundbuy"

# PayPal Sandbox Credentials (get these from developer.paypal.com)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Default Currency
DEFAULT_CURRENCY="USD"

# Shipment Tracking & Delivery Intelligence (BoundBuy Track)
# TRACKING_PROVIDER: 'manual' (default) or 'aftership'
TRACKING_PROVIDER="aftership"
AFTERSHIP_API_KEY_READ=""
AFTERSHIP_API_KEY_WRITE=""
AFTERSHIP_BASE_URL="https://api.aftership.com/tracking/2026-07"
AFTERSHIP_WEBHOOK_SECRET=""
